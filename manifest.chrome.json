{
  "manifest_version": 3,
  "name": "Gem Bridge Extension",
  "short_name": "Gem Bridge",
  "version": "0.1.0",
  "description": "Browser extension companion for Gem Bridge, enabling controlled local-first communication with the local daemon.",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "action": {
    "default_title": "Gem Bridge Extension",
    "default_popup": "popup/index.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content/providers/chatgpt_adapter.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
